# The REALITY target of the edge connection test: the site the REALITY node
# borrows its TLS handshake from. `tls internal` with on-demand issuance answers
# a TLS 1.3 handshake for ANY server name the family lists, like a multi-tenant
# host serving all of them.
{
	admin off
	on_demand_tls {
		ask http://127.0.0.1:9123/ok
	}
}

http://127.0.0.1:9123 {
	respond /ok 200
}

:443 {
	tls internal {
		on_demand
	}
	respond "reality-target"
}
