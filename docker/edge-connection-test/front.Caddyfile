# The fake L7 edge of the edge connection test: a CDN front. It terminates TLS
# for the edge hostnames of the fake provider's zone (a wildcard from the
# per-run test CA) and proxies the WebSocket to the node's ORIGIN hostname over
# TLS, verifying the origin's certificate like a CDN does. The Host header the
# origin sees is the FRONT's hostname, as a CDN forwards it (Caddy would
# otherwise send the upstream's name to an HTTPS upstream).
#
# The access log is the proof that a member's session crossed THIS front.
{
	admin off
	auto_https off
	default_sni front.{$EC_L7_ZONE}
}

:443 {
	tls /pki/front.pem /pki/front-key.pem
	log {
		output file /logs/front-access.log
		format json
	}
	reverse_proxy https://{$EC_ORIGIN_HOSTNAME}:443 {
		header_up Host {host}
		transport http {
			tls_server_name {$EC_ORIGIN_HOSTNAME}
			tls_trust_pool file /pki/ca.pem
		}
	}
}
