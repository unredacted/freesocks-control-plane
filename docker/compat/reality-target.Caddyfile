# The REALITY key share test (convex/lib/realityKeyShares.integration.test.ts):
# the site both Xray-cores borrow their TLS handshake from (`tls internal` with
# on-demand issuance answers a TLS 1.3 handshake for the test's server name),
# and the page a working tunnel reaches (the Xray outbounds redirect here; it
# answers with the path, so a fetch proves it went through).
{
	admin off
	on_demand_tls {
		ask http://127.0.0.1:9123/ok
	}
}

http://127.0.0.1:9123 {
	respond /ok 200
}

:443 {
	tls internal {
		on_demand
	}
	respond "reality-target"
}

:8080 {
	respond "reality-page {path}"
}
